#include<bits/stdc++.h>
using namespace std;

float func(float x){

    return 3*x - cos(x) - 1;
}

int main(){
    cout<<"Enter the value of a and b: ";
    float x1, x2, x3;
    cin>>x1>>x2;

    while(1){

        x3 = x2 - ((x2-x1)/(func(x2)-func(x1)))*func(x2);

        if(fabs(x3-x2)<0.0001){
            cout<<"Roots : "<<x3;
            break;
        }
        x1 = x2;
        x2 = x3;
    }
    return 0;
}
