#include <iostream>
#include <iomanip>
using namespace std;

int main() {
    int n;
    cout << "Enter number of data points: ";
    cin >> n;

    double x[n], dd[n][n];

    cout << "Enter x and y values:\n";
    for(int i = 0; i < n; i++) {
        cin >> x[i] >> dd[i][0];
    }

    // Divided Difference Table
    for(int j = 1; j < n; j++) {
        for(int i = 0; i < n - j; i++) {
            dd[i][j] = (dd[i + 1][j - 1] - dd[i][j - 1]) /
                       (x[i + j] - x[i]);
        }
    }

    // Print Table
    cout << "\nDivided Difference Table:\n";
    for(int i = 0; i < n; i++) {
        for(int j = 0; j < n - i; j++) {
            cout << setw(12) << dd[i][j] << " ";
        }
        cout << endl;
    }

    double value;
    cout << "\nEnter value of x to interpolate: ";
    cin >> value;

    // Newton Interpolation Formula
    double result = dd[0][0];
    double term = 1;

    for(int i = 1; i < n; i++) {
        term *= (value - x[i - 1]);
        result += term * dd[0][i];
    }

    cout << fixed << setprecision(6);
    cout << "\nInterpolated value at x = "
         << value << " is: " << result << endl;

    return 0;
}
