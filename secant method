#include<bits/stdc++.h>
using namespace std;
float func(float x){
    return x*x*x - x*x - 2;
}

int main(){
    cout<<"Enter two value of x0 and x1: ";
    float x0, x1, x2;
    cin>>x0>>x1;
    if(func(x0)*func(x1)>=0){
        cout<<"Invalid....";
        return 0;
    }
    cout<<fixed<<setprecision(3);
    cout<<left<<setw(10)<<"Xi+1"<<setw(10)<<"Xi"<<setw(10)<<"Xi-1"<<endl;
    while(1){
       x2 = x1 - ((x1-x0)/(func(x1)-func(x0)))*func(x1);
        cout<<left<<setw(10)<<x2<<setw(10)<<x1<<setw(10)<<x0<<endl;
       if(fabs(x2-x1)<0.0001){
            cout<<"Roots: "<<x2;
        break;
       }
       x0 = x1;
       x1 = x2;

    }
    return 0;
}
